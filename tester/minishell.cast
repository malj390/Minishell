[5.208699, "o", "\u001b[1m                MINISHELL INTERACTIVE TESTER                \u001b[0m\r\n\u001b[0;36m==============================================================\u001b[0m\r\n"]
[5.208727, "o", "\r\n\u001b[1;33m\u001b[1mAvailable Tests:\u001b[0m\r\n\r\n \u001b[0;34m--- Run Interactive Sessions ---\u001b[0m\r\n  \u001b[0;32m1)\u001b[0m Mandatory tests with \u001b[1mBash\u001b[0m\r\n"]
[5.208768, "o", "  \u001b[0;32m2)\u001b[0m Mandatory tests with \u001b[1mMinishell\u001b[0m\r\n  \u001b[0;32m3)\u001b[0m Bonus tests with \u001b[1mBash\u001b[0m\r\n  \u001b[0;32m4)\u001b[0m Bonus tests with \u001b[1mMinishell\u001b[0m\r\n\r\n \u001b[0;34m--- Comparisons & Reports ---\u001b[0m\r\n  \u001b[0;32m5)\u001b[0m Compare \u001b[1mMandatory\u001b[0m results (Text + MD)\r\n"]
[5.208807, "o", "  \u001b[0;32m6)\u001b[0m Compare \u001b[1mBonus\u001b[0m results (Text + MD)\r\n\r\n \u001b[0;34m--- Other Tests ---\u001b[0m\r\n  \u001b[0;32m7)\u001b[0m Run \u001b[1mNon-Interactive\u001b[0m tests\r\n  \u001b[0;32m8)\u001b[0m Test \u001b[1mExit Codes & Signals\u001b[0m (Ctrl+C, Ctrl+\\, Ctrl+D)\r\n\r\n \u001b[0;34m--- Automated Suites ---\u001b[0m\r\n"]
[5.208824, "o", "  \u001b[0;32m9)\u001b[0m \u001b[1mRun ALL Mandatory\u001b[0m (Interactive, Non-Interactive, Signals)\r\n  \u001b[0;32m10)\u001b[0m \u001b[1mRun ALL Bonus\u001b[0m (Interactive, Non-Interactive, Signals)\r\n"]
[5.208833, "o", "\r\n  \u001b[0;31mq)\u001b[0m Exit\r\n"]
