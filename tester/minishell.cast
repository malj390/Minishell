[70.997244, "o", "export A=1\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $A\r\r\n\u001b[?2004l\r1\r\r\n\u001b[?2004hbash$> export B=2\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $B\r\r\n\u001b[?2004l\r2\r\r\n\u001b[?2004hbash$> export C=3\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $C\r\r\n\u001b[?2004l\r3\r\r\n\u001b[?2004hbash$> unset B\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $A\r\r\n\u001b[?2004l\r1\r\r\n\u001b[?2004hbash$> echo $B\r\r\n\u001b[?2004l\r\r\r\n\u001b[?2004hbash$> echo $C\r\r\n\u001b[?2004l\r3\r\r\n\u001b[?2004hbash$> env | grep -E \"^A=|^B=|^C=\" | sort\r\r\n\u001b[?2004l\rA=1\r\r\nC=3\r\r\n\u001b[?2004hbash$> export a=b\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $a\r\r\n\u001b[?2004l\rb\r\r\n\u001b[?2004hbash$> export b=wawa\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $b\r\r\n\u001b[?2004l\rwawa\r\r\n\u001b[?2004hbash$> export b=lala\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $b\r\r\n\u001b[?2004l\rlala\r\r\n\u001b[?2004hbash$> export c=lala=kaka\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $c\r\r\n\u001b[?2004l\rlala=kaka\r\r\n\u001b[?2004hbash$> export a=\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo \"|$a|\"\r\r\n\u001b[?2004l\r||\r\r\n\u001b[?2004hbash$> export a3=l\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $a3\r\r\n\u001b[?2004l\rl\r\r\n\u001b[?2004hbash$> "]
[77.9012, "o", "export 2a=lala\r\r\n\u001b[?2004l\rbash: export: `2a=lala': not a valid identifier\r\r\n\u001b[?2004hbash$> export NUEVA=$TERM\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $NUEVA\r\r\n\u001b[?2004l\rxterm\r\r\n\u001b[?2004hbash$> export POLLOS=asados\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $POLLOS\r\r\n\u001b[?2004l\rasados\r\r\n\u001b[?2004hbash$> unset POLLOS\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $POLLOS\r\r\n\u001b[?2004l\r\r\r\n\u001b[?2004hbash$> export A=1 B=2\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $A $B\r\r\n\u001b[?2004l\r1 2\r\r\n\u001b[?2004hbash$> unset A B\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $A $B\r\r\n\u001b[?2004l\r\r\r\n\u001b[?2004hbash$> export a= b=o\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $a $b\r\r\n\u001b[?2004l\ro\r\r\n\u001b[?2004hbash$> export a===\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $a\r\r\n\u001b[?2004l\r==\r\r\n\u001b[?2004hbash$> export \"\"\r\r\n\u001b[?2004l\rbash: export: `': not a valid identifier\r\r\n\u001b[?2004hbash$> env\r\r\n\u001b[?2004l\rSHELL=/usr/bin/fish\r\r\n_MSDIR=/app\r\r\nASCIINEMA_REC=1\r\r\nHOSTNAME=42container\r\r\nLANGUAGE=en_US:en\r\r\nSSH_AUTH_SOCK=/ssh-agent\r\r\nPWD=/app\r\r\nC=3\r\r\na3=l\r\r\nc=lala=kaka\r\r\nHOME=/home/42user\r\r\nb=o\r\r\na===\r\r\nLANG=en_US.UTF-8\r\r\nNUEVA=xterm\r\r\nHISTFILE=/home/42user/.bas"]
