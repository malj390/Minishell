[157.953145, "o", "echo '$USER is not expanded in single quotes'\r\r\n\u001b[?2004l\r$USER is not expanded in single quotes\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"hello world\"\r\r\n\u001b[?2004l\rhello world\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"spaces   preserved\"\r\r\n\u001b[?2004l\rspaces   preserved\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"cat lol.c | cat > lol.c\"\r\r\n\u001b[?2004l\rcat lol.c | cat > lol.c\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mexport DQTEST=expanded\r\r\n\u001b[?2004l\r\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho $DQTEST\r\r\n\u001b[?2004l\rexpanded\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"$DQTEST\"\r\r\n\u001b[?2004l\rexpanded\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m"]
