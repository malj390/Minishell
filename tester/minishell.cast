[139.342939, "o", "echo hello world\r\r\n\u001b[?2004l\rhello world\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"\"\r\r\n\u001b[?2004l\r\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"  spaces  \"\r\r\n\u001b[?2004l\r  spaces  \r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho -n one -n two\r\r\n\u001b[?2004l\rone -n two\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho one two   three\r\r\n\u001b[?2004l\rone two three\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m"]
[140.843762, "o", "echo \r\r\n\u001b[?2004l\r\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"\" hola\r\r\n\u001b[?2004l\r hola\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho -n -n hola\r\r\n\u001b[?2004l\rhola\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho -n -nh -n hola\r\r\n\u001b[?2004l\r-nh -n hola\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho -nnnnnnnnn hola\r\r\n\u001b[?2004l\rhola\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m"]
[142.344583, "o", "echo 'echo \"hola'\r\r\n\u001b[?2004l\recho \"hola\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho $?hcudshfuewrf ew  wr 4ew\"\"\"\"\r\r\n\u001b[?2004l\r0hcudshfuewrf ew wr 4ew\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"\"uhjkhnkj\"hjbmb\"'''' defdjhfkjb \"iujiouhj\"f'f'f'f'f''f'f'f'f'f'f'\r\r\n\u001b[?2004l\ruhjkhnkjhjbmb defdjhfkjb iujiouhjfffffffffff\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"\"uhjkhnkj\"hjbmb\"'''' defdjhfkjb \"iujiouhj\"f'f'a'j'o''i'w'q''q\r\r\n\u001b[?2004l\ruhjkhnkjhjbmb defdjhfkjb iujiouhjffajoiwqq\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"\"aaaaaaaa\"bbbbb\"'''' ccccccccc \"dddddddd\"e'e'e\r\r\n\u001b[?2004l\raaaaaaaabbbbb ccccccccc ddddddddeee\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m"]
[143.845398, "o", "echo \"ho   $USER\"  'la   $LESS'   $USER$TERM\r\r\n\u001b[?2004l\rho   42user la   $LESS 42userxterm\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"ho   $USER\"'la   $LESS'$USER$TERM\r\r\n\u001b[?2004l\rho   42userla   $LESS42userxterm\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho\"ho   $USER\"\r\r\n\u001b[?2004l\rminishell: echoho   42user: command not found\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho\"ho   $USE$LESS\"\r\r\n\u001b[?2004l\rminishell: echoho   : command not found\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m\"echo\" \"ho   $USER\"\r\r\n\u001b[?2004l\rho   42user\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m"]
[145.346362, "o", "e\"cho\" \"ho   $USER\"\r\r\n\u001b[?2004l\rho   42user\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m       echo \"ho   $USER\"\r\r\n\u001b[?2004l\rho   42user\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"$HOME '$LESS' $USER\"\r\r\n\u001b[?2004l\r/home/42user '' 42user\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho '$HOME \"$LESS\" $USER'\r\r\n\u001b[?2004l\r$HOME \"$LESS\" $USER\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho '$'\"HOME\"\r\r\n\u001b[?2004l\r$HOME\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m"]
