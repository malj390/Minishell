[85.104807, "o", "echo \"c file\" > /tmp/ms_wildcard_test/foo.c\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo \"h file\" > /tmp/ms_wildcard_test/foo.h\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo \"txt file\" > /tmp/ms_wildcard_test/bar.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cd /tmp/ms_wildcard_test\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo *.c\r\r\n\u001b[?2004l\rfoo.c\r\r\n\u001b[?2004hbash$> echo *.h\r\r\n\u001b[?2004l\rfoo.h\r\r\n\u001b[?2004hbash$> echo *.txt\r\r\n\u001b[?2004l\rbar.txt\r\r\n\u001b[?2004hbash$> ls *.c\r\r\n\u001b[?2004l\rfoo.c\r\r\n\u001b[?2004hbash$> ls *.h\r\r\n\u001b[?2004l\rfoo.h\r\r\n\u001b[?2004hbash$> echo *\r\r\n\u001b[?2004l\rbar.txt foo.c foo.h\r\r\n\u001b[?2004hbash$> cd $_MSDIR\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> rm -rf /tmp/ms_wildcard_test\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat < colors.txt\r\r\n\u001b[?2004l\rred\r\r\ngreen\r\r\nblue\r\r\nyellow\r\r\n\u001b[?2004hbash$> cat < colors.txt > copia.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat copia.txt\r\r\n\u001b[?2004l\rred\r\r\ngreen\r\r\nblue\r\r\nyellow\r\r\n\u001b[?2004hbash$> rm -f copia.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat colors.txt | wc\r\r\n\u001b[?2004l\r      4       4      22\r\r\n\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo \"extra\" > /tmp/ms_logic_a.txt && cat /tmp/ms_logic_a."]
[85.104909, "o", "txt\r\r\n\u001b[?2004l\rextra\r\r\n\u001b[?2004hbash$> echo one && echo two\r\r\n\u001b[?2004l\rone\r\r\ntwo\r\r\n\u001b[?2004hbash$> true && echo \"true_passed\"\r\r\n\u001b[?2004l\rtrue_passed\r\r\n\u001b[?2004hbash$> false && echo \"SHOULD_NOT_PRINT\"\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> false || echo \"false_recovered\"\r\r\n\u001b[?2004l\rfalse_recovered\r\r\n\u001b[?2004hbash$> true || echo \"SHOULD_NOT_PRINT\"\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[93.809298, "o", "echo \"start\" && false || echo \"fallback\"\r\r\n\u001b[?2004l\rstart\r\r\nfallback\r\r\n\u001b[?2004hbash$> false || false || echo \"last_resort\"\r\r\n\u001b[?2004l\rlast_resort\r\r\n\u001b[?2004hbash$> true && true && echo \"all_true\"\r\r\n\u001b[?2004l\rall_true\r\r\n\u001b[?2004hbash$> false || true && echo \"chain_ok\"\r\r\n\u001b[?2004l\rchain_ok\r\r\n\u001b[?2004hbash$> (echo uno && (false || echo dos)) && echo tres\r\r\n\u001b[?2004l\runo\r\r\ndos\r\r\ntres\r\r\n\u001b[?2004hbash$> (false && echo \"nope\") || (true && echo \"ok\")\r\r\n\u001b[?2004l\rok\r\r\n\u001b[?2004hbash$> (echo \"A\" && (false || (echo \"B\" && true))) || echo \"C\"\r\r\n\u001b[?2004l\rA\r\r\nB\r\r\n\u001b[?2004hbash$> (true && (false || (true && echo \"deep\"))) && echo \"final\"\r\r\n\u001b[?2004l\rdeep\r\r\nfinal\r\r\n\u001b[?2004hbash$> (echo \"start\" && (false || (echo \"mid\" && false)) && echo \"never\") || echo \"end\"\r\r\n\u001b[?2004l\rstart\r\r\nmid\r\r\nend\r\r\n\u001b[?2004hbash$> (false || (false && echo \"no\") || (true && echo \"yes\")) && echo \"done\"\r\r\n\u001b[?2004l\ryes\r\r\ndone\r\r\n\u001b[?2004hbash$> mkdir test_ls_bool\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cd test_ls_bool\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> touch file1 file2 file3\r\r\n\u001b[?2004l\r\u001b[?2"]
[93.809406, "o", "004hbash$> ls && echo \"exito\"\r\r\n\u001b[?2004l\rfile1  file2  file3\r\r\nexito\r\r\n\u001b[?2004hbash$> ls archivo_que_no_existe && echo \"no se ve\"\r\r\n\u001b[?2004l\rls: cannot access 'archivo_que_no_existe': No such file or directory\r\r\n\u001b[?2004hbash$> ls || echo \"no se ve\"\r\r\n\u001b[?2004l\rfile1  file2  file3\r\r\n\u001b[?2004hbash$> ls archivo_que_no_existe || echo \"se ve\"\r\r\n\u001b[?2004l\rls: cannot access 'archivo_que_no_existe': No such file or directory\r\r\nse ve\r\r\n\u001b[?2004hbash$> true && echo \"exito\" || echo \"fallo\"\r\r\n\u001b[?2004l\rexito\r\r\n\u001b[?2004hbash$> false && echo \"no se ve\" || echo \"se ve\"\r\r\n\u001b[?2004l\rse ve\r\r\n\u001b[?2004hbash$> ls && ls && ls && ls && echo \"todos exitosos\"\r\r\n\u001b[?2004l\rfile1  file2  file3\r\r\nfile1  file2  file3\r\r\nfile1  file2  file3\r\r\nfile1  file2  file3\r\r\ntodos exitosos\r\r\n\u001b[?2004hbash$> ls && ls archivo_que_no_existe && ls && ls\r\r\n\u001b[?2004l\rfile1  file2  file3\r\r\nls: cannot access 'archivo_que_no_existe': No such file or directory\r\r\n\u001b[?2004hbash$> ls || ls || ls || ls\r\r\n\u001b[?2004l\rfile1  file2  file3\r\r\n\u001b[?2004hbash$> ls archivo_que_no_existe ||"]
[93.809444, "o", " echo \"recuperacion\" && echo \"continua\"\r\r\n\u001b[?2004l\rls: cannot access 'archivo_que_no_existe': No such file or directory\r\r\nrecuperacion\r\r\ncontinua\r\r\n\u001b[?2004hbash$> (ls && echo \"dentro de parentesis\") && echo \"fuera de parentesis\"\r\r\n\u001b[?2004l\rfile1  file2  file3\r\r\ndentro de parentesis\r\r\nfuera de parentesis\r\r\n\u001b[?2004hbash$> (ls archivo_que_no_existe || echo \"recuperado\") && echo \"continua\"\r\r\n\u001b[?2004l\rls: cannot access 'archivo_que_no_existe': No such file or directory\r\r\nrecuperado\r\r\ncontinua\r\r\n\u001b[?2004hbash$> false || (true && echo \"esto se ve\")\r\r\n\u001b[?2004l\resto se ve\r\r\n\u001b[?2004hbash$> true && (false || echo \"esto tambien\")\r\r\n\u001b[?2004l\resto tambien\r\r\n\u001b[?2004hbash$> true && true || false && false\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> false && false || true && true\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[102.515643, "o", "(ls && echo a) && (ls && echo b) || (ls && echo c)\r\r\n\u001b[?2004l\rfile1  file2  file3\r\r\na\r\r\nfile1  file2  file3\r\r\nb\r\r\n\u001b[?2004hbash$> cd ..\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> rm -rf test_ls_bool\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> rm -f /tmp/ms_logic_a.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r\u001b[?2004hbash$> mkdir -p /tmp/ms_user42_test\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> mkdir -p /tmp/ms_user42_test/dir_existe\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> touch /tmp/ms_user42_test/file_existe\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> mkdir -p /tmp/ms_user42_test/dir_noperm\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> chmod 000 /tmp/ms_user42_test/dir_noperm\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo -e \"red\\ngreen\\nblue\\nyellow\" > /tmp/ms_user42_test/colors.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cd /tmp/ms_user42_test\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $?hcudshfuewrf ew  wr 4ew\"\"\r\r\n\u001b[?2004l\r0hcudshfuewrf ew wr 4ew\r\r\n\u001b[?2004hbash$> echo \"ho   $USER\"  \"la   $LESS\"   $USER$TERM\r\r\n\u001b[?2004l\rho   42user la    42userxterm\r\r\n\u001b[?2004hbash$> echo \"ho   $USER\"\r\r\n\u001b[?2004l\rho   42user\r\r\n\u001b[?2004hbash$> echo\"ho   $USER\"\r\r\n\u001b[?2004l\rbas"]
[102.515749, "o", "h: echoho   42user: command not found\r\r\n\u001b[?2004hbash$> e\"cho\" \"ho   $USER\"\r\r\n\u001b[?2004l\rho   42user\r\r\n\u001b[?2004hbash$>        echo \"ho   $USER\"\r\r\n\u001b[?2004l\rho   42user\r\r\n\u001b[?2004hbash$> echo \"$HOME\" \"$USER\"\r\r\n\u001b[?2004l\r/home/42user 42user\r\r\n\u001b[?2004hbash$> cd dir_existe\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> pwd\r\r\n\u001b[?2004l\r/tmp/ms_user42_test/dir_existe\r\r\n\u001b[?2004hbash$> cd directorio_no_existe\r\r\n\u001b[?2004l\rbash: cd: directorio_no_existe: No such file or directory\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r1\r\r\n\u001b[?2004hbash$> cd file_existe\r\r\n\u001b[?2004l\rbash: cd: file_existe: No such file or directory\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r1\r\r\n\u001b[?2004hbash$> cd /tmp/ms_user42_test\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cd\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> pwd\r\r\n\u001b[?2004l\r/home/42user\r\r\n\u001b[?2004hbash$> ls | wc\r\r\n\u001b[?2004l\r      1       1       8\r\r\n\u001b[?2004hbash$> "]
[111.520406, "o", "ls|wc\r\r\n\u001b[?2004l\r      1       1       8\r\r\n\u001b[?2004hbash$> echo \"colorinchis\" > colors.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat colors.txt | sort -r | wc\r\r\n\u001b[?2004l\r      1       1      12\r\r\n\u001b[?2004hbash$> cd -\r\r\n\u001b[?2004l\r/tmp/ms_user42_test\r\r\n\u001b[?2004hbash$> pwd\r\r\n\u001b[?2004l\r/tmp/ms_user42_test\r\r\n\u001b[?2004hbash$> cd ~\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> pwd\r\r\n\u001b[?2004l\r/home/42user\r\r\n\u001b[?2004hbash$> cd $_MSDIR\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> chmod 755 /tmp/ms_user42_test/dir_noperm\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> rm -rf /tmp/ms_user42_test\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r\u001b[?2004hbash$> export _SAVED_PATH=$PATH\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> unset PATH\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> ls\r\r\n\u001b[?2004l\rbash: ls: No such file or directory\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r127\r\r\n\u001b[?2004hbash$> /bin/ls\r\r\n\u001b[?2004l\rBonus_tests.md\tinteractive   minishell       non_interactive  run_tests.sh\r\r\ncolors.txt\tmanual_tests  minishell.cast  results\t       utils\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r0\r\r\n\u001b[?2004hbash$> export PATH=$_SAVED_PATH\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> un"]
[111.520527, "o", "set _SAVED_PATH\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> ls noexiste\r\r\n\u001b[?2004l\rls: cannot access 'noexiste': No such file or directory\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r2\r\r\n\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit\r\r\n\u001b[?2004l\rexit\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r0\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit 0\r\r\n\u001b[?2004l\rexit\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r0\r\r\n\u001b[?2004hbash$> "]
[120.825427, "o", "bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit 42\r\r\n\u001b[?2004l\rexit\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r42\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit -42\r\r\n\u001b[?2004l\rexit\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r214\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit 2147483647\r\r\n\u001b[?2004l\rexit\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r255\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit -2147483648\r\r\n\u001b[?2004l\rexit\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r0\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit 9223372036854775807\r\r\n\u001b[?2004l\rexit\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r255\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit -9223372036854775808\r\r\n\u001b[?2004l\rexit\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r0\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit 9223372036854775808\r\r\n\u001b[?2004l\rexit\r\r\nbash: exit: 9223372036854775808: numeric argument required\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r2\r"]
[120.825545, "o", "\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit -9223372036854775809\r\r\n\u001b[?2004l\rexit\r\r\nbash: exit: -9223372036854775809: numeric argument required\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r2\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit +100\r\r\n\u001b[?2004l\rexit\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r100\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit ++100\r\r\n\u001b[?2004l\rexit\r\r\nbash: exit: ++100: numeric argument required\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r2\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[129.529714, "o", "exit +++100\r\r\n\u001b[?2004l\rexit\r\r\nbash: exit: +++100: numeric argument required\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r2\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit --100\r\r\n\u001b[?2004l\rexit\r\r\nbash: exit: --100: numeric argument required\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r2\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit exit\r\r\n\u001b[?2004l\rexit\r\r\nbash: exit: exit: numeric argument required\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r2\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit 42 53 64\r\r\n\u001b[?2004l\rexit\r\r\nbash: exit: too many arguments\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r1\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit hola mundo\r\r\n\u001b[?2004l\rexit\r\r\nbash: exit: hola: numeric argument required\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r2\r\r\n\u001b[?2004hbash$> bash --norc --noprofile\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> exit 42hola\r\r\n\u001b[?2004l\rexit\r\r\nbash: exit: 42hola: numeric argument required\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r2\r\r\n\u001b[?2004hbash$> \r\r\n\u001b["]
[129.529811, "o", "?2004l\r\u001b[?2004hbash$> mkdir test_ls_syntax\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cd test_ls_syntax\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> touch file1 file2 file3\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> ls || wc\r\r\n\u001b[?2004l\rfile1  file2  file3\r\r\n\u001b[?2004hbash$> ls |   | wc\r\r\n\u001b[?2004l\rbash: syntax error near unexpected token `|'\r\r\n\u001b[?2004hbash$> | ls | wc\r\r\n\u001b[?2004l\rbash: syntax error near unexpected token `|'\r\r\n\u001b[?2004hbash$> ls | wc |\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> echo \"mensaje ignorado\"\r\r\n\u001b[?2004l\rmensaje ignorado\r\r\n\u001b[?2004hbash$> cd ..\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> rm -rf test_ls_syntax\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> rm colors.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
