[77.901319, "o", "*.webm=01;35:*.webp=01;35:*.ogm=01;35:*.mp4=01;35:*.m4v=01;35:*.mp4v=01;35:*.vob=01;35:*.qt=01;35:*.nuv=01;35:*.wmv=01;35:*.asf=01;35:*.rm=01;35:*.rmvb=01;35:*.flc=01;35:*.avi=01;35:*.fli=01;35:*.flv=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.yuv=01;35:*.cgm=01;35:*.emf=01;35:*.ogv=01;35:*.ogx=01;35:*.aac=00;36:*.au=00;36:*.flac=00;36:*.m4a=00;36:*.mid=00;36:*.midi=00;36:*.mka=00;36:*.mp3=00;36:*.mpc=00;36:*.ogg=00;36:*.ra=00;36:*.wav=00;36:*.oga=00;36:*.opus=00;36:*.spx=00;36:*.xspf=00;36:\r\r\nDQTEST=expanded\r\r\nTERM=xterm\r\r\nUSER=42user\r\r\nSHLVL=4\r\r\nPS1=bash$> \r\r\nLC_ALL=en_US.UTF-8\r\r\nPATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\r\r\nDEBIAN_FRONTEND=noninteractive\r\r\nOLDPWD=/app/test_ls_pipe_wc\r\r\n_=/usr/bin/env\r\r\n\u001b[?2004hbash$> env lalal\r\r\n\u001b[?2004l\renv: ‘lalal’: No such file or directory\r\r\n\u001b[?2004hbash$> env directorio\r\r\n\u001b[?2004l\renv: ‘directorio’: No such file or directory\r\r\n\u001b[?2004hbash$> unset\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> unset $HOME $USER\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r"]
