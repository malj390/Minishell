[214.384417, "o", "echo \"start\" && false || echo \"fallback\"\r\r\n\u001b[?2004l\rstart\r\r\nfallback\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mfalse || false || echo \"last_resort\"\r\r\n\u001b[?2004l\rlast_resort\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mtrue && true && echo \"all_true\"\r\r\n\u001b[?2004l\rall_true\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mfalse || true && echo \"chain_ok\"\r\r\n\u001b[?2004l\rchain_ok\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m(echo uno && (false || echo dos)) && echo tres\r\r\n\u001b[?2004l\runo\r\r\ndos\r\r\ntres\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m(false && echo \"nope\") || (true && echo \"ok\")\r\r\n\u001b[?2004l\rok\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m(echo \"A\" && (false || (echo \"B\" && true))) || echo \"C\"\r\r\n\u001b[?2004l\rA\r\r\nB\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m(true && (false || (true && echo \"deep\"))) && echo \"final\"\r\r\n\u001b[?2004l\rdeep\r\r\nfinal\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0m(echo \"start\" && (false || (echo \"mid\" && false)) && echo \"never\") || echo \"end\"\r\r\n\u001b[?2004l\rstart\r\r\nmid\r\r\nend\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m"]
[214.384536, "o", "$> \u001b[0m(false || (false && echo \"no\") || (true && echo \"yes\")) && echo \"done\"\r\r\n\u001b[?2004l\ryes\r\r\ndone\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mmkdir test_ls_bool\r\r\n\u001b[?2004l\r\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mcd test_ls_bool\r\r\n\u001b[?2004l\r\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mtouch file1 file2 file3\r\r\n\u001b[?2004l\r\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mls && echo \"exito\"\r\r\n\u001b[?2004l\rfile1  file2  file3\r\r\nexito\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mls archivo_que_no_existe && echo \"no se ve\"\r\r\n\u001b[?2004l\rls: cannot access 'archivo_que_no_existe': No such file or directory\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mls || echo \"no se ve\"\r\r\n\u001b[?2004l\rfile1  file2  file3\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mls archivo_que_no_existe || echo \"se ve\"\r\r\n\u001b[?2004l\rls: cannot access 'archivo_que_no_existe': No such file or directory\r\r\nse ve\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mtrue && echo \"exito\" || echo \"fallo\"\r\r\n\u001b[?2004l\rexito\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mfalse && echo \"no se ve\""]
