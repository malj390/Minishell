[205.679198, "o", "echo \"c file\" > /tmp/ms_wildcard_test/foo.c\r\r\n\u001b[?2004l\r\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"h file\" > /tmp/ms_wildcard_test/foo.h\r\r\n\u001b[?2004l\r\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho \"txt file\" > /tmp/ms_wildcard_test/bar.txt\r\r\n\u001b[?2004l\r\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mcd /tmp/ms_wildcard_test\r\r\n\u001b[?2004l\r\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho *.c\r\r\n\u001b[?2004l\rfoo.c\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho *.h\r\r\n\u001b[?2004l\rfoo.h\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho *.txt\r\r\n\u001b[?2004l\rbar.txt\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mls *.c\r\r\n\u001b[?2004l\rfoo.c\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mls *.h\r\r\n\u001b[?2004l\rfoo.h\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mecho *\r\r\n\u001b[?2004l\rbar.txt foo.c foo.h\r\r\n\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mcd $_MSDIR\r\r\n\u001b[?2004l\r\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mrm -rf /tmp/ms_wildcard_test\r\r\n\u001b[?2004l\r\u001b[?2004h\u001b[1;32mMinishell\u001b[0m\u001b[1;34m$> \u001b[0mcat < colors.txt\r\r\n\u001b[?2004l\rred\r\r\ngreen\r\r\nblue\r\r\nyellow\r\r\n\u001b[?2004h\u001b[1;32m"]
