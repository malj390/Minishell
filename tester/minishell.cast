[9.861442, "o", "export _MSDIR=$PWD\r\r\n\u001b[?2004l\r"]
[9.861494, "o", "\u001b[?2004hbash$> "]
[15.162131, "o", "export _MSDIR=$PWD\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[15.462536, "o", "echo \"red\" > colors.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[16.062863, "o", "echo \"green\" >> colors.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo \"blue\" >> colors.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[17.263543, "o", "echo \"yellow\" >> colors.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo hello\r\r\n\u001b[?2004l\rhello\r\r\n\u001b[?2004hbash$> echo -n noeol\r\r\n\u001b[?2004l\rnoeol\u001b[?2004hbash$> echo -n\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[18.764346, "o", "echo hello world\r\r\n\u001b[?2004l\rhello world\r\r\n\u001b[?2004hbash$> echo \"\"\r\r\n\u001b[?2004l\r\r\r\n\u001b[?2004hbash$> echo \"  spaces  \"\r\r\n\u001b[?2004l\r  spaces  \r\r\n\u001b[?2004hbash$> echo -n one -n two\r\r\n\u001b[?2004l\rone -n two\u001b[?2004hbash$> echo one two   three\r\r\n\u001b[?2004l\rone two three\r\r\n\u001b[?2004hbash$> "]
[20.26513, "o", "echo \r\r\n\u001b[?2004l\r\r\r\n\u001b[?2004hbash$> echo \"\" hola\r\r\n\u001b[?2004l\r hola\r\r\n\u001b[?2004hbash$> echo -n -n hola\r\r\n\u001b[?2004l\rhola\u001b[?2004hbash$> echo -n -nh -n hola\r\r\n\u001b[?2004l\r-nh -n hola\u001b[?2004hbash$> echo -nnnnnnnnn hola\r\r\n\u001b[?2004l\rhola\u001b[?2004hbash$> "]
[21.766137, "o", "echo 'echo \"hola'\r\r\n\u001b[?2004l\recho \"hola\r\r\n\u001b[?2004hbash$> echo $?hcudshfuewrf ew  wr 4ew\"\"\"\"\r\r\n\u001b[?2004l\r0hcudshfuewrf ew wr 4ew\r\r\n\u001b[?2004hbash$> echo \"\"uhjkhnkj\"hjbmb\"'''' defdjhfkjb \"iujiouhj\"f'f'f'f'f''f'f'f'f'f'f'\r\r\n\u001b[?2004l\ruhjkhnkjhjbmb defdjhfkjb iujiouhjfffffffffff\r\r\n\u001b[?2004hbash$> echo \"\"uhjkhnkj\"hjbmb\"'''' defdjhfkjb \"iujiouhj\"f'f'a'j'o''i'w'q''q\r\r\n\u001b[?2004l\ruhjkhnkjhjbmb defdjhfkjb iujiouhjffajoiwqq\r\r\n\u001b[?2004hbash$> echo \"\"aaaaaaaa\"bbbbb\"'''' ccccccccc \"dddddddd\"e'e'e\r\r\n\u001b[?2004l\raaaaaaaabbbbb ccccccccc ddddddddeee\r\r\n\u001b[?2004hbash$> "]
[23.267401, "o", "echo \"ho   $USER\"  'la   $LESS'   $USER$TERM\r\r\n\u001b[?2004l\rho   42user la   $LESS 42userxterm\r\r\n\u001b[?2004hbash$> echo \"ho   $USER\"'la   $LESS'$USER$TERM\r\r\n\u001b[?2004l\rho   42userla   $LESS42userxterm\r\r\n\u001b[?2004hbash$> echo\"ho   $USER\"\r\r\n\u001b[?2004l\rbash: echoho   42user: command not found\r\r\n\u001b[?2004hbash$> echo\"ho   $USE$LESS\"\r\r\n\u001b[?2004l\rbash: echoho   : command not found\r\r\n\u001b[?2004hbash$> \"echo\" \"ho   $USER\"\r\r\n\u001b[?2004l\rho   42user\r\r\n\u001b[?2004hbash$> "]
[24.767943, "o", "e\"cho\" \"ho   $USER\"\r\r\n\u001b[?2004l\rho   42user\r\r\n\u001b[?2004hbash$>        echo \"ho   $USER\"\r\r\n\u001b[?2004l\rho   42user\r\r\n\u001b[?2004hbash$> echo \"$HOME '$LESS' $USER\"\r\r\n\u001b[?2004l\r/home/42user '' 42user\r\r\n\u001b[?2004hbash$> echo '$HOME \"$LESS\" $USER'\r\r\n\u001b[?2004l\r$HOME \"$LESS\" $USER\r\r\n\u001b[?2004hbash$> echo '$'\"HOME\"\r\r\n\u001b[?2004l\r$HOME\r\r\n\u001b[?2004hbash$> "]
[26.268986, "o", "\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> pwd\r\r\n\u001b[?2004l\r/app\r\r\n\u001b[?2004hbash$> cd /tmp\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> pwd\r\r\n\u001b[?2004l\r/tmp\r\r\n\u001b[?2004hbash$> cd /\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[27.769756, "o", "pwd\r\r\n\u001b[?2004l\r/\r\r\n\u001b[?2004hbash$> cd /usr/bin\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> pwd\r\r\n\u001b[?2004l\r/usr/bin\r\r\n\u001b[?2004hbash$> cd ..\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> pwd\r\r\n\u001b[?2004l\r/usr\r\r\n\u001b[?2004hbash$> "]
[29.270997, "o", "cd .\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> pwd\r\r\n\u001b[?2004l\r/usr\r\r\n\u001b[?2004hbash$> cd /nonexistent_directory_xyz\r\r\n\u001b[?2004l\rbash: cd: /nonexistent_directory_xyz: No such file or directory\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r1\r\r\n\u001b[?2004hbash$> cd $_MSDIR\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[30.771976, "o", "export _SAVED_HOME=$HOME\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> unset HOME\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cd\r\r\n\u001b[?2004l\rbash: cd: HOME not set\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r1\r\r\n\u001b[?2004hbash$> export HOME=$_SAVED_HOME\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[32.272976, "o", "unset _SAVED_HOME\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cd $_MSDIR\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cd -\r\r\n\u001b[?2004l\r/app\r\r\n\u001b[?2004hbash$> pwd\r\r\n\u001b[?2004l\r/app\r\r\n\u001b[?2004hbash$> cd ~\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[33.773847, "o", "pwd\r\r\n\u001b[?2004l\r/home/42user\r\r\n\u001b[?2004hbash$> cd $_MSDIR\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo '$USER'\r\r\n\u001b[?2004l\r$USER\r\r\n\u001b[?2004hbash$> echo '$?'\r\r\n\u001b[?2004l\r$?\r\r\n\u001b[?2004hbash$> "]
[35.274404, "o", "echo 'hello world'\r\r\n\u001b[?2004l\rhello world\r\r\n\u001b[?2004hbash$> echo ''\r\r\n\u001b[?2004l\r\r\r\n\u001b[?2004hbash$> echo 'no | pipe here'\r\r\n\u001b[?2004l\rno | pipe here\r\r\n\u001b[?2004hbash$> echo 'no > redirect'\r\r\n\u001b[?2004l\rno > redirect\r\r\n\u001b[?2004hbash$> echo 'spaces   preserved'\r\r\n\u001b[?2004l\rspaces   preserved\r\r\n\u001b[?2004hbash$> "]
[37.375795, "o", "echo '$USER is not expanded in single quotes'\r\r\n\u001b[?2004l\r$USER is not expanded in single quotes\r\r\n\u001b[?2004hbash$> echo \"hello world\"\r\r\n\u001b[?2004l\rhello world\r\r\n\u001b[?2004hbash$> echo \"spaces   preserved\"\r\r\n\u001b[?2004l\rspaces   preserved\r\r\n\u001b[?2004hbash$> echo \"cat lol.c | cat > lol.c\"\r\r\n\u001b[?2004l\rcat lol.c | cat > lol.c\r\r\n\u001b[?2004hbash$> export DQTEST=expanded\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $DQTEST\r\r\n\u001b[?2004l\rexpanded\r\r\n\u001b[?2004hbash$> echo \"$DQTEST\"\r\r\n\u001b[?2004l\rexpanded\r\r\n\u001b[?2004hbash$> "]
[40.077491, "o", "echo \"value is $DQTEST end\"\r\r\n\u001b[?2004l\rvalue is expanded end\r\r\n\u001b[?2004hbash$> echo \"$?\"\r\r\n\u001b[?2004l\r0\r\r\n\u001b[?2004hbash$> echo \"'$USER'\"\r\r\n\u001b[?2004l\r'42user'\r\r\n\u001b[?2004hbash$> echo '\"$USER\"'\r\r\n\u001b[?2004l\r\"$USER\"\r\r\n\u001b[?2004hbash$> echo \"$COMPLICADO\"\r\r\n\u001b[?2004l\r\r\r\n\u001b[?2004hbash$> echo '$COMPLICADO'\r\r\n\u001b[?2004l\r$COMPLICADO\r\r\n\u001b[?2004hbash$> echo \"'$COMPLICADO'\"\r\r\n\u001b[?2004l\r''\r\r\n\u001b[?2004hbash$> echo '\"$COMPLICADO\"'\r\r\n\u001b[?2004l\r\"$COMPLICADO\"\r\r\n\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[42.779349, "o", "echo \"first line\" > /tmp/ms_test_redir.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat /tmp/ms_test_redir.txt\r\r\n\u001b[?2004l\rfirst line\r\r\n\u001b[?2004hbash$> echo \"second line\" >> /tmp/ms_test_redir.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat /tmp/ms_test_redir.txt\r\r\n\u001b[?2004l\rfirst line\r\r\nsecond line\r\r\n\u001b[?2004hbash$> echo \"third line\" >> /tmp/ms_test_redir.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> wc -l < /tmp/ms_test_redir.txt\r\r\n\u001b[?2004l\r3\r\r\n\u001b[?2004hbash$> echo \"overwrite\" > /tmp/ms_test_redir.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat /tmp/ms_test_redir.txt\r\r\n\u001b[?2004l\roverwrite\r\r\n\u001b[?2004hbash$> rm /tmp/ms_test_redir.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[46.682025, "o", "echo hola > /tmp/ms_rout1.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat /tmp/ms_rout1.txt\r\r\n\u001b[?2004l\rhola\r\r\n\u001b[?2004hbash$> echo caracola >> /tmp/ms_rout1.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat /tmp/ms_rout1.txt\r\r\n\u001b[?2004l\rhola\r\r\ncaracola\r\r\n\u001b[?2004hbash$> echo hola > /tmp/ms_rout1.txt > /tmp/ms_rout2.txt > /tmp/ms_rout3.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat /tmp/ms_rout1.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat /tmp/ms_rout2.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat /tmp/ms_rout3.txt\r\r\n\u001b[?2004l\rhola\r\r\n\u001b[?2004hbash$> rm -f /tmp/ms_rout1.txt /tmp/ms_rout2.txt /tmp/ms_rout3.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat << EOF\r\r\n\u001b[?2004l\r\u001b[?2004h> line one\r\r\n\u001b[?2004l\r\u001b[?2004h> line two\r\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.086298, "o", "line three\r\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\r\n\u001b[?2004l\rline one\r\r\nline two\r\r\nline three\r\r\n\u001b[?2004hbash$> grep \"an\" << WORDS\r\r\n\u001b[?2004l\r\u001b[?2004h> apple\r\r\n\u001b[?2004l\r\u001b[?2004h> banana\r\r\n\u001b[?2004l\r\u001b[?2004h> cherry\r\r\n\u001b[?2004l\r\u001b[?2004h> mango\r\r\n\u001b[?2004l\r\u001b[?2004h> WORDS\r\r\n\u001b[?2004l\rbanana\r\r\nmango\r\r\n\u001b[?2004hbash$> wc -l << COUNTER\r\r\n\u001b[?2004l\r\u001b[?2004h> a\r\r\n\u001b[?2004l\r\u001b[?2004h> b\r\r\n\u001b[?2004l\r\u001b[?2004h> c\r\r\n\u001b[?2004l\r\u001b[?2004h> d\r\r\n\u001b[?2004l\r\u001b[?2004h> e\r\r\n\u001b[?2004l\r\u001b[?2004h> COUNTER\r\r\n\u001b[?2004l\r5\r\r\n\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo hello | cat\r\r\n\u001b[?2004l\rhello\r\r\n\u001b[?2004hbash$> echo hello | cat | cat\r\r\n\u001b[?2004l\rhello\r\r\n\u001b[?2004hbash$> "]
[57.489274, "o", "echo hello | wc -c\r\r\n\u001b[?2004l\r6\r\r\n\u001b[?2004hbash$> /bin/ls /dev/null | cat\r\r\n\u001b[?2004l\r/dev/null\r\r\n\u001b[?2004hbash$> echo \"apple banana cherry\" | tr ' ' '\\n' | sort\r\r\n\u001b[?2004l\rapple\r\r\nbanana\r\r\ncherry\r\r\n\u001b[?2004hbash$> echo \"abc\" | rev | rev\r\r\n\u001b[?2004l\rabc\r\r\n\u001b[?2004hbash$> echo \"line1\" > /tmp/ms_pipe_a.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo \"line2\" >> /tmp/ms_pipe_a.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo \"line3\" >> /tmp/ms_pipe_a.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat /tmp/ms_pipe_a.txt | wc -l\r\r\n\u001b[?2004l\r3\r\r\n\u001b[?2004hbash$> cat /tmp/ms_pipe_a.txt | grep \"line\" | wc -l\r\r\n\u001b[?2004l\r3\r\r\n\u001b[?2004hbash$> cat /tmp/ms_pipe_a.txt | sort -r > /tmp/ms_pipe_b.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat /tmp/ms_pipe_b.txt\r\r\n\u001b[?2004l\rline3\r\r\nline2\r\r\nline1\r\r\n\u001b[?2004hbash$> rm /tmp/ms_pipe_a.txt /tmp/ms_pipe_b.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> mkdir test_ls_pipe_wc\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cd test_ls_pipe_wc\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> touch file1 file2 file3\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> ls | wc\r\r\n\u001b[?2004l\r      3       3      18\r\r\n\u001b[?2004hbash$> ls|wc\r\r\n\u001b[?2004l\r"]
[57.489388, "o", "      3       3      18\r\r\n\u001b[?2004hbash$> cd ..\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> "]
[64.093499, "o", "rm -rf test_ls_pipe_wc\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> wc < colors.txt > /tmp/ms_wc_out.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat /tmp/ms_wc_out.txt\r\r\n\u001b[?2004l\r 4  4 22\r\r\n\u001b[?2004hbash$> rm -f /tmp/ms_wc_out.txt\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> cat colors.txt | wc\r\r\n\u001b[?2004l\r      4       4      22\r\r\n\u001b[?2004hbash$> \r\r\n\u001b[?2004l\r\u001b[?2004hbash$> export TESTVAR=hello42\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $TESTVAR\r\r\n\u001b[?2004l\rhello42\r\r\n\u001b[?2004hbash$> export TESTVAR=updated\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $TESTVAR\r\r\n\u001b[?2004l\rupdated\r\r\n\u001b[?2004hbash$> echo $?\r\r\n\u001b[?2004l\r0\r\r\n\u001b[?2004hbash$> unset TESTVAR\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $TESTVAR\r\r\n\u001b[?2004l\r\r\r\n\u001b[?2004hbash$> export MY_VAR=hello\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $MY_VAR\r\r\n\u001b[?2004l\rhello\r\r\n\u001b[?2004hbash$> env | grep MY_VAR\r\r\n\u001b[?2004l\rMY_VAR=hello\r\r\n\u001b[?2004hbash$> export MY_VAR=updated\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $MY_VAR\r\r\n\u001b[?2004l\rupdated\r\r\n\u001b[?2004hbash$> env | grep MY_VAR\r\r\n\u001b[?2004l\rMY_VAR=updated\r\r\n\u001b[?2004hbash$> unset MY_VAR\r\r\n\u001b[?2004l\r\u001b[?2004hbash$> echo $MY_VAR\r\r\n\u001b[?2004l\r\r\r\n\u001b[?2004"]
